#include "fsm_machine.h"

uint8_t cmd_buffer[MAX_BUFFER_SIZE];
uint8_t cmd_idx = 0;
uint8_t parser_state = 0;
uint8_t command_flag = 0;
uint8_t command_data = 0;

void command_parser_fsm() {
    switch (parser_state) {
        case PARSER_INIT:
            if (temp == '!') {
                parser_state = PARSER_READING;
                cmd_idx = 0;
                memset(cmd_buffer, 0, MAX_BUFFER_SIZE);
            }
            break;

        case PARSER_READING:
            if (temp == '#') {
                parser_state = PARSER_INIT;
                cmd_buffer[cmd_idx] = '\0';

                if (strcmp((char*)cmd_buffer, "RST") == 0) {
                    command_flag = 1;
                    command_data = COMMAND_RST;
                }
                 else if (strcmp((char*)cmd_buffer, "OK") == 0) {
                    command_flag = 1;
                    command_data = COMMAND_OK;
                }
            }
            else {
                if (temp != '!') {
                    cmd_buffer[cmd_idx++] = temp;
                    if (cmd_idx >= MAX_BUFFER_SIZE) cmd_idx = 0;
                }
            }
            break;
    }
}

uint8_t uart_comm_status = UART_COMM_WAIT;
uint32_t saved_ADC_Value = 0;

void uart_communication_fsm() {
    char str[50];

    switch (uart_comm_status) {
        case UART_COMM_WAIT:
            if (command_flag == 1) {
                if (command_data == COMMAND_RST) {
                    saved_ADC_Value = HAL_ADC_GetValue(&hadc1);
                    command_flag = 0;
                    uart_comm_status = UART_COMM_SEND;
                }
            }
            break;

        case UART_COMM_SEND:
            sprintf(str, "!ADC=%lu#\r\n", saved_ADC_Value);
            HAL_UART_Transmit(&huart2, (uint8_t*)str, strlen(str), 1000);

            setTimer(1, 3000);

            uart_comm_status = UART_COMM_WAIT_OK;
            break;

        case UART_COMM_WAIT_OK:
            if (command_flag == 1 && command_data == COMMAND_OK) {
                command_flag = 0;
                uart_comm_status = UART_COMM_WAIT;
            }
            else if (IsTimerExpired(1)) {
                uart_comm_status = UART_COMM_SEND;
            }
            break;

        default:
            uart_comm_status = UART_COMM_WAIT;
            break;
    }
}

